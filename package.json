{
  "name": "bigbank-dragon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12.4.2 <13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @bigbank-dragon/web test:e2e",
    "bot": "pnpm --filter @bigbank-dragon/api bot",
    "bench": "pnpm --filter @bigbank-dragon/api bench",
    "test:integration": "pnpm --filter @bigbank-dragon/api test:integration",
    "db:migrate": "pnpm --filter @bigbank-dragon/api db:migrate",
    "db:make": "pnpm --filter @bigbank-dragon/api db:make"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
