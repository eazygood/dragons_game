{
  "name": "@bigbank-dragon/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "tsx src/tools/capture.ts",
    "test": "vitest run --project unit --project contract",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "db:make": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:make -x ts"
  },
  "dependencies": {
    "@bigbank-dragon/contracts": "workspace:*",
    "knex": "3.3.0",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
